{
  "name": "loom-glyph-tokens",
  "version": 1,
  "date": "2026-09-05",
  "note": "Two modes, one geometry. Accents are ranked task, hazard, changed; two show at a time. Contrast is against each mode's field.",
  "accent_rank": ["task", "hazard", "changed"],
  "accent_show": 2,
  "modes": {
    "dark": {
      "field":     "#000000",
      "ink":       "#ADADB3",
      "ink_hover": "#C7C7CC",
      "dim":       "#6B6B70",
      "surface":   "#0A0A0B",
      "well":      "#1A1A1C",
      "edge":      "#38383D",
      "ghost":     "rgba(107,107,112,0.45)",
      "hazard":    "#8B1E1E",
      "task":      "#D99A1F",
      "changed":   "#6B8FAE",
      "contrast_on_field": {"ink": 9.4, "dim": 4.0, "hazard": 2.3, "task": 8.6, "changed": 6.2}
    },
    "light": {
      "field":     "#FFFFFF",
      "ink":       "#4A4A50",
      "ink_hover": "#303036",
      "dim":       "#8E8E94",
      "surface":   "#F7F7F8",
      "well":      "#EDEDEF",
      "edge":      "#D2D2D6",
      "ghost":     "rgba(142,142,148,0.45)",
      "hazard":    "#8B1E1E",
      "task":      "#A06E10",
      "changed":   "#4F7291",
      "contrast_on_field": {"ink": 8.8, "dim": 3.3, "hazard": 9.1, "task": 4.4, "changed": 5.1}
    }
  },
  "tile": {
    "size": 64,
    "stroke": 2,
    "skin_box": [16, 16, 32, 32],
    "frames": {
      "persona": "circle cx 32 cy 32 r 28",
      "process": "rect 4,10 56x44, square corners",
      "tool":    "rect 4,10 56x44 with bars at x 11 and x 53",
      "null":    "rect 4,4 56x56, dashed 4 4, dim"
    },
    "states": {
      "not_started": "hollow: skin stroke ink, no fill",
      "done":        "solid: skin fill ink",
      "running":     "motion: outline animates; not a fill",
      "abandoned":   "subdued: whole tile at 20 % opacity",
      "broken":      "skin fill hazard; frame stays ink"
    },
    "modifiers": {
      "current_task":  "frame stroke task; 1 px ring at r 32 (or rect 0,6 64x52) in task at 50 %, pulsing",
      "changed_since": "frame stroke changed",
      "both":          "frame task, skin hazard; changed drops"
    }
  }
}
